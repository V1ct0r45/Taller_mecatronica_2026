<?xml version="1.0"?>
<robot name="torreta_pan_tilt" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- MUNDO Y ANCLAJE (Para que no caiga al vacío)-->
  <!-- ========================================== -->
  <link name="world"/>

  <joint name="fixed_base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================================== -->
  <!-- BASE FIXA (El soporte estático)            -->
  <!-- ========================================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Revisa que en tu carpeta meshes el archivo se llame exactamente Base_link.stl (con B mayúscula) -->
        <mesh filename="package://turret_description/meshes/Base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!-- ARTICULACIÓN 1: PAN (Giro Horizontal)      -->
  <!-- ========================================== -->
  <joint name="pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="pan_link"/>
    <origin xyz="0 -0.01014 0.123" rpy="0 0 0"/> 
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="2.0" velocity="1.0"/>
  </joint>

  <!-- ========================================== -->
  <!-- ESLABÓN 1 (La pieza en U / Eslabon1_link)  -->
  <!-- ========================================== -->
  <link name="pan_link">
    <visual>
      <!-- RECORREMOS LA PIEZA HACIA ABAJO PARA COMPENSAR FREECAD -->
      <origin xyz="0 0 -0.123" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turret_description/meshes/Eslabon1_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.4 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <!-- Centroides ajustados a la nueva altura -->
      <origin xyz="0 0.039 0.095" rpy="0 0 0"/> 
      <geometry>
        <box size="0.100 0.118 0.190"/> 
      </geometry>
    </collision>

    <inertial>
      <!-- Centro de masa ajustado a la nueva altura -->
      <origin xyz="0 0.035 0.085" rpy="0 0 0"/> 
      <mass value="0.142"/> 
      <inertia ixx="0.00059" ixy="0.0" ixz="0.0" iyy="0.00054" iyz="0.0" izz="0.00027"/>
    </inertial>
  </link>

</robot>