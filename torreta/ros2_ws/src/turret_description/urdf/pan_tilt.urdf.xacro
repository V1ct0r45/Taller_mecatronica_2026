<?xml version="1.0"?>
<robot name="torreta_pan_tilt" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- MUNDO Y ANCLAJE -->
  <!-- ========================================== -->
  <link name="world"/>

  <joint name="fixed_base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================================== -->
  <!-- BASE ESTÁTICA -->
  <!-- ========================================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turret_description/meshes/Base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!-- MOTOR 1: PAN (Giro Horizontal) -->
  <!-- ========================================== -->
  <joint name="pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="pan_link"/>
    <origin xyz="0 0 0.123" rpy="0 0 0"/> 
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.5"/>
  </joint>

  <!-- ========================================== -->
  <!-- ESLABÓN 1 (Pieza azul en U) -->
  <!-- ========================================== -->
  <link name="pan_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turret_description/meshes/Eslabon1_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.039 0.095" rpy="0 0 0"/> 
      <geometry>
        <box size="0.100 0.118 0.190"/> 
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.00130 0.00515 0.06382" rpy="0 0 0"/> 
      <mass value="0.142"/> 
      <inertia ixx="0.00059" ixy="0.0" ixz="0.0" iyy="0.00054" iyz="0.0" izz="0.00027"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!-- MOTOR 2: TILT (Cabeceo Vertical) -->
  <!-- ========================================== -->
  <joint name="tilt_joint" type="revolute">
    <parent link="pan_link"/>
    <child link="tilt_link"/>
    <origin xyz="0.03008 0.01895 0.11477" rpy="0 0 0"/> 
    <axis xyz="1 0 0"/> 
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.5"/>
  </joint>

  <!-- ========================================== -->
  <!-- ESLABÓN 2 (Soporte de la cámara) -->
  <!-- ========================================== -->
  <link name="tilt_link">
    <visual>
      <origin xyz="0 -0.006 0.006" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turret_description/meshes/Eslabon_2_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.0 0.0 0.5 1.0"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turret_description/meshes/Eslabon_2_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    
    <inertial>
      <origin xyz="-0.02813 -0.04462 0.04276" rpy="0 0 0"/> 
      <mass value="0.070"/> 
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

 <!-- ========================================== -->
  <!-- ARTICULACIÓN DE LA CÁMARA (Fija) -->
  <!-- ========================================== -->
  <joint name="camera_joint" type="fixed">
    <parent link="tilt_link"/>
    <child link="camera_link"/>
    <origin xyz="-0.03036 -0.11550 0.05558" rpy="0 0 0"/> 
  </joint>

  <!-- ========================================== -->
  <!-- ESLABÓN 3: CÁMARA (Modelo 3D) -->
  <!-- ========================================== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0.00988 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turret_description/meshes/Camera.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.03"/> 
      </geometry>
    </collision>
    
    <inertial>
      <origin xyz="0 -0.00782 0" rpy="0 0 0"/>
      <mass value="0.050"/> 
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!-- NUEVO: ESLABÓN ÓPTICO (Rotación para OpenCV) -->
  <!-- ========================================== -->
  <link name="camera_link_optical"></link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <!-- Compensación exacta para que Z (Azul) apunte al frente -->
    <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
  </joint>

  <!-- ========================================== -->
  <!-- SENSOR VIRTUAL DE GAZEBO -->
  <!-- ========================================== -->
  <gazebo reference="camera_link">
    <sensor name="torreta_camera" type="camera">
      <pose>0 0 0 0 0 0</pose> 
      <visualize>true</visualize> 
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.57</horizontal_fov> 
        <image>
          <format>R8G8B8</format>
          <width>1920</width>
          <height>1080</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far> 
        </clip>
      </camera>
      <topic>/camera/image_raw</topic>
      <!-- IMPORTANTE: El sensor ahora publica usando el eslabón óptico -->
      <gz_frame_id>camera_link_optical</gz_frame_id>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <!-- ========================================== -->
  <!-- SISTEMA DE CONTROL (Músculos virtuales) -->
  <!-- ========================================== -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="pan_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="tilt_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/torreta_ws/torreta/ros2_ws/install/turret_description/share/turret_description/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>