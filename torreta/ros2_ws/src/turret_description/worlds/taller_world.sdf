<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="taller_world">
    <!-- Motores de físicas y comunicación necesarios para ROS 2 / Gazebo Harmonic -->
    <plugin filename="libgz-sim-physics-system.so" name="gz::sim::systems::Physics"/>
    <plugin filename="libgz-sim-scene-broadcaster-system.so" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="libgz-sim-user-commands-system.so" name="gz::sim::systems::UserCommands"/>
    
    <!-- Configuración de la interfaz y posición inicial de la cámara -->
    <gui fullscreen="0">
      <plugin filename="GzScene3D" name="3D View">
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4 1</ambient_light>
        <background_color>0.8 0.8 0.8 1</background_color>
        <camera_pose>1.5 0.0 0.8 0 0.4 3.1416</camera_pose>
        <camera_target>0 0 0.2</camera_target>
      </plugin>
      <plugin filename="WorldControl" name="World control"/>
      <plugin filename="WorldStats" name="World stats"/>
      <plugin filename="EntityTree" name="Entity tree"/>
    </gui>

    <!-- Luz del sol -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- El suelo de nuestro laboratorio (3x3) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3 3</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3 3</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>



      <!-- PELOTA NARANJA: dinámica pero sin gravedad, movible por velocidad -->
    <model name="pelota_naranja">
      <static>false</static>
      <pose>0 -0.8 0.3 0 0 0</pose>

      <link name="link">
        <!-- Clave: la pelota ignora la gravedad -->
        <gravity>false</gravity>

        <inertial>
          <mass>0.1</mass>
          <!-- Inercia de esfera sólida: I = 2/5 m r^2 = 0.0001 -->
          <inertia>
            <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0001</iyy><iyz>0</iyz>
            <izz>0.0001</izz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <sphere><radius>0.05</radius></sphere>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <sphere><radius>0.05</radius></sphere>
          </geometry>
          <material>
            <ambient>1.0 0.45 0.0 1</ambient>
            <diffuse>1.0 0.5 0.0 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>

      <!-- Permite mover la pelota publicando una velocidad en /ball/cmd_vel -->
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
        <topic>/ball/cmd_vel</topic>
      </plugin>
    </model>
  </world>
</sdf>